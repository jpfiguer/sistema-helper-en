# sistema-helper-en — copia este archivo a .env y completa las tres claves.
#   cp .env.example .env
#
# .env está en .gitignore. No lo commitees.

# ── Obligatorias ──────────────────────────────────────────────────────────────

# Deepgram — transcribe tu inglés hablado.  https://console.deepgram.com
DEEPGRAM_API_KEY=

# Groq — el entrevistador y el evaluador.   https://console.groq.com/keys
GROQ_API_KEY=

# Cartesia — la voz del entrevistador.      https://play.cartesia.ai
CARTESIA_API_KEY=

# Voz del catálogo de Cartesia para el entrevistador.
# Elige una NATIVA de inglés: practicar contra un acento nativo es parte del ejercicio.
# No uses un clon de tu propia voz — la sesión se siente como un eco y no como una entrevista.
CARTESIA_VOICE_ID=

# ── Opcionales: modelos ───────────────────────────────────────────────────────

# Modelo del entrevistador. Necesita ser rápido: cada turno se escucha en vivo.
GROQ_MODEL=openai/gpt-oss-120b

# Modelo del evaluador. Puede ser más grande y lento: corre después de la respuesta,
# cuando ya no estás esperando. Si no lo defines, usa el mismo de arriba.
# GROQ_MODEL_EVAL=

# Los puestos contra los que te entrevista. Cámbialo a lo que estés buscando:
# el entrevistador ajusta el nivel y el vocabulario de las preguntas.
ROLES_OBJETIVO=Senior Data Engineer, AI Engineer, Data Architect

# ── Opcionales: audio ─────────────────────────────────────────────────────────

# Micrófono. Vacío = el de por defecto del sistema. Para ver los nombres: npm run check
# INPUT_DEVICE=

# Salida. Vacío = parlantes por defecto. Los dispositivos de audio virtual
# (BlackHole, Loopback, Soundflower, VB-Cable) se rechazan por diseño: ver README.
# OUTPUT_DEVICE=

# Velocidad del entrevistador. 1.0 para empezar; súbelo a 1.2 cuando ya lo sigas cómodo.
CARTESIA_SPEED=1.0
CARTESIA_VOLUME=1.5
CARTESIA_SAMPLE_RATE=24000

# ── Opcionales: ritmo de la sesión ────────────────────────────────────────────

# Silencio (ms) tras tu última palabra para dar la respuesta por terminada.
# Súbelo si te corta mientras piensas; bájalo si la sesión se siente lenta.
# Silencio para cerrar cuando hay texto esperado (lectura y entrevista con apoyo).
# Leyendo se hacen pausas más largas que improvisando.
SILENCIO_FIN_GUIADO_MS=5000

SILENCIO_FIN_MS=3000

# Silencio (ms) que Deepgram espera antes de cerrar un segmento. Más alto = frases enteras.
DEEPGRAM_ENDPOINTING=1200

# Puerto de la UI.
PORT=3002

# Guardado de sesiones a sesiones/*.jsonl. 'off' para no escribir nada a disco;
# pierdes el reporte de progreso entre sesiones.
SESSION_LOG=on

# Ruta a ffmpeg si no está en el PATH.
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
