# sistema-helper-en: copia este archivo a .env y completa las claves.
#   cp .env.example .env
#
# .env está en .gitignore. No lo commitees.

# ── Obligatorias ──────────────────────────────────────────────────────────────

# Deepgram: transcribe tu inglés hablado.   https://console.deepgram.com
DEEPGRAM_API_KEY=

# Groq: el entrevistador y el evaluador.    https://console.groq.com/keys
GROQ_API_KEY=

# ── Voz del entrevistador ─────────────────────────────────────────────────────

# Proveedor: cartesia (por defecto) o say.
# say es el sintetizador de macOS: gratis, sin red y sin clave, con peor calidad. Sirve para
# seguir practicando cuando se acaban los créditos de Cartesia.
TTS_PROVIDER=cartesia

# Voz de say. `say -v '?'` lista las instaladas.
# SAY_VOICE=Samantha

# Cartesia: obligatoria si TTS_PROVIDER=cartesia.   https://play.cartesia.ai
CARTESIA_API_KEY=

# Voz del catálogo de Cartesia para el entrevistador. Elige una nativa de inglés; no uses un
# clon de tu propia voz, porque la sesión se sentiría como un eco y no como una entrevista.
CARTESIA_VOICE_ID=

# Modelo de Cartesia.
# CARTESIA_MODEL=sonic-3
# Idioma de la voz de Cartesia.
# CARTESIA_LANGUAGE=en
# Versión de la API de Cartesia (header Cartesia-Version).
# CARTESIA_VERSION=2024-11-13

# Velocidad del entrevistador. 1.0 para empezar; súbelo a 1.2 cuando ya lo sigas cómodo.
CARTESIA_SPEED=1.0
# Volumen que se le pide a Cartesia.
CARTESIA_VOLUME=1.5
# Sample rate del audio sintetizado, con Cartesia o con say. Es parte de la clave del caché.
CARTESIA_SAMPLE_RATE=24000

# Carpeta del caché de audio sintetizado. Por defecto, cache/tts dentro del repo.
# TTS_CACHE_DIR=
# Tope del caché en MB. Pasado eso se borra lo menos usado.
# TTS_CACHE_MAX_MB=200

# ── Opcionales: modelos ───────────────────────────────────────────────────────

# Modelo del entrevistador. Necesita ser rápido: cada turno se escucha en vivo.
GROQ_MODEL=openai/gpt-oss-120b

# Modelo del evaluador. Puede ser más grande y lento: corre después de la respuesta,
# cuando ya no estás esperando. Si no lo defines, usa el mismo de arriba.
# GROQ_MODEL_EVAL=

# Los puestos contra los que te entrevista. Cámbialo a lo que estés buscando:
# el entrevistador ajusta el nivel y el vocabulario de las preguntas.
ROLES_OBJETIVO=Senior Data Engineer, AI Engineer, Data Architect

# ── Opcionales: audio ─────────────────────────────────────────────────────────

# Micrófono. Vacío = el de por defecto del sistema. Para ver los nombres: npm run check
# INPUT_DEVICE=

# Salida. Vacío = parlantes por defecto. Si aquí pones un dispositivo de audio virtual
# (BlackHole, Loopback, Soundflower, VB-Cable), se rechaza: ver README.
# OUTPUT_DEVICE=

# Ruta a ffmpeg si no está en el PATH.
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# ── Opcionales: transcripción y ritmo de la sesión ────────────────────────────

# Idioma que transcribe Deepgram.
# DEEPGRAM_LANGUAGE=en-US

# Silencio (ms) que Deepgram espera antes de cerrar un segmento. Más alto = frases enteras.
DEEPGRAM_ENDPOINTING=1200

# Silencio (ms) tras tu última palabra para dar la respuesta por terminada.
# Súbelo si te corta mientras piensas; bájalo si la sesión se siente lenta.
SILENCIO_FIN_MS=3000

# Lo mismo cuando hay texto esperado (lectura y entrevista con apoyo): leyendo se hacen
# pausas más largas que improvisando.
SILENCIO_FIN_GUIADO_MS=5000

# ── Opcionales: servidor y sesiones ───────────────────────────────────────────

# Puerto de la UI. El servidor escucha solo en 127.0.0.1.
PORT=3002

# Guardado de sesiones en JSONL. 'off' para no escribir nada a disco; pierdes el reporte de
# progreso entre sesiones.
SESSION_LOG=on

# Carpeta de las sesiones, para el servidor y para npm run reporte. Por defecto, sesiones/.
# SESSION_DIR=
